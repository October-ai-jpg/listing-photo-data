{
  "name": "Listing photo apps and services compared",
  "description": "58 real estate photo tools in one table: capture apps, AI editors, human editing services, virtual staging, 3D tour and video tools, with who does the work, platforms, price basis, lowest published US-dollar price, the price in the vendor's words, turnaround, video, staging, whether altered photos are labelled, the source URL and the date each row was checked.",
  "url": "https://www.october-ai.com/data",
  "source_page": "https://www.october-ai.com/guides/real-estate-photo-apps-compared",
  "creator": "October (october-ai.com)",
  "license": "CC BY 4.0",
  "license_url": "https://creativecommons.org/licenses/by/4.0/",
  "attribution": "Source: October, october-ai.com/data",
  "date_modified": "2026-10-27",
  "spatial_coverage": "United States",
  "changelog": [
    {
      "date": "2026-10-22",
      "change": "First release: 53 tools, each row copied from one of our guides, which read it from the vendor's own pages between 20 and 22 October 2026."
    },
    {
      "date": "2026-10-27",
      "change": "Added 5 capture apps: ListKit, Listing Candy (formerly LensCasa), Listing Camera, ListingPix and PropLens, each read from its US App Store listing and its own site on 27 October 2026."
    }
  ],
  "fields": [
    {
      "name": "name",
      "description": "The app or service, as the vendor names it."
    },
    {
      "name": "url",
      "description": "The vendor's own site (its App Store listing where it has no site)."
    },
    {
      "name": "category",
      "description": "One of: capture app, AI editor, editing service (human), virtual staging, 3D/tour, video."
    },
    {
      "name": "who_does_the_work",
      "description": "Who makes the finished image: you + app, AI, human editor, AI + human review, photographer. \"you + app\" means you shoot and the app processes automatically."
    },
    {
      "name": "platforms",
      "description": "Where it runs, as our guide states it."
    },
    {
      "name": "price_basis",
      "description": "What price_from_usd counts: per photo, per listing, per month, credit pack, free, not published."
    },
    {
      "name": "price_from_usd",
      "description": "The lowest published paid price in US dollars for that basis (for a subscription, the lowest monthly price, which may need yearly billing); empty if none is published in dollars."
    },
    {
      "name": "price_text",
      "description": "The price exactly as our guide states it."
    },
    {
      "name": "turnaround",
      "description": "How fast results come back, as our guide states it (quotes are the vendor's words); empty if not stated."
    },
    {
      "name": "makes_video",
      "description": "true if it makes a video; false if our guide says it lists none; empty if not stated."
    },
    {
      "name": "virtual_staging",
      "description": "true if it offers virtual staging; false if our guide says it does not; empty if not stated."
    },
    {
      "name": "labels_altered_photos",
      "description": "true if the vendor says it labels (or offers to label) staged or altered photos; false if it says it does not; empty if not stated."
    },
    {
      "name": "source_url",
      "description": "The vendor page (or dated capture, where the vendor's page did not load) the price is read from."
    },
    {
      "name": "checked",
      "description": "The day our guide says the row's facts were checked (YYYY-MM-DD)."
    },
    {
      "name": "guide_slug",
      "description": "Our guide with the details: october-ai.com/guides/<guide_slug>."
    }
  ],
